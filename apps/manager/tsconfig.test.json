{
  // Purpose: tsx/node:test config for manager unit tests with $lib path aliases.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "$app/environment": ["src/lib/test-shims/app-environment.ts"],
      "$lib/*": ["src/lib/*"]
    }
  }
}
