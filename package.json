{
  "name": "shugu3",
  "version": "1.0.0",
  "description": "Interactive art performance system with manager, client and server",
  "private": true,
  "scripts": {
    "dev:all": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @shugu/server run dev",
    "dev:manager": "pnpm --filter @shugu/manager run dev",
    "dev:client": "pnpm --filter @shugu/client run dev",
    "e2e:node-executor": "node scripts/e2e/node-executor.mjs",
    "e2e:node-executor:offline": "pnpm --filter @shugu/sdk-client exec node scripts/e2e/node-executor.offline.mjs",
    "test:node-core": "pnpm --filter @shugu/node-core run test",
    "test:core": "pnpm test:node-core && pnpm e2e:node-executor:offline",
    "validate:node-specs": "node scripts/validate-node-specs.mjs",
    "harness:validate": "python3 .harness/scripts/validate_harness.py",
    "harness:hotspots": "python3 .harness/scripts/check_hotspots.py",
    "harness:verify": "pnpm harness:validate && pnpm harness:hotspots && pnpm validate:node-specs",
    "guard:ff08": "node .harness/scripts/ff08/guard-manager-boundary.mjs",
    "test:ff08": "pnpm tsx --test apps/manager/src/lib/stores/group-controls.spec.ts",
    "test:ff09": "pnpm --filter @shugu/node-core run test && pnpm tsx --test apps/manager/src/lib/components/nodes/node-canvas/adapters/semantic-command-adapter.spec.ts && node .harness/evidence/FF-09/semantic-cli-fixture.mjs && node .harness/evidence/FF-09/ui-semantic-mutation-guard.mjs",
    "verify": "pnpm guard:deps && pnpm lint && pnpm build:all && pnpm test:node-core && pnpm test:ff08 && pnpm test:ff09 && pnpm validate:node-specs && pnpm e2e:node-executor:offline && pnpm guard:ff08 && pnpm harness:verify",
    "test:node-canvas": "pnpm tsx --test \"apps/manager/src/lib/components/nodes/node-canvas/groups/**/*.spec.ts\"",
    "guard:deps": "node scripts/guard-deps.mjs && node scripts/guard-server-messages.mjs",
    "guard:server-messages": "node scripts/guard-server-messages.mjs",
    "build:all": "pnpm -r run build",
    "lint": "ESLINT_USE_FLAT_CONFIG=true pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,svelte,js,json,css,md}\"",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "keywords": [
    "interactive-art",
    "websocket",
    "svelte",
    "threejs"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.1",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.1",
    "socket.io-client": "^4.7.2",
    "svelte-eslint-parser": "^1.4.1",
    "tsx": "^4.21.0"
  }
}
