{
  "name": "@shugu/ai-core",
  "version": "1.0.0",
  "description": "Pluggable AI runtime interface (lazy init, zero overhead when disabled)",
  "main": "./dist-ai-core/index.js",
  "module": "./dist-ai-core/index.js",
  "types": "./dist-ai-core/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-ai-core/index.d.ts",
      "import": "./dist-ai-core/index.js"
