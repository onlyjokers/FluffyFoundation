{
  "name": "@shugu/arduino-uno-plugin",
  "version": "1.0.0",
  "description": "Arduino UNO serial hardware plugin and node definitions.",
  "main": "./dist-arduino-uno-plugin-out/index.js",
  "module": "./dist-arduino-uno-plugin-out/index.js",
  "types": "./dist-arduino-uno-plugin-out/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-arduino-uno-plugin-out/index.d.ts",
      "import": "./dist-arduino-uno-plugin-out/index.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc",
    "dev": "pnpm exec tsc --watch",
