          "nodeIds": [
            "n-agent-message",
            "n-message-preview",
            "n-display-text",
            "n-client-count",
            "n-client-range",
            "n-client",
            "n-flashlight",
            "n-rate",
            "n-duty",
            "n-screen-color",
            "n-display"
          ],
          "allowNewNodes": true
        },
        "budgets": {
          "maxNodes": 16,
          "maxConnections": 20,
          "maxParamsPerCommand": 8,
          "maxCommandsPerTurn": 12,
          "maxRetries": 2
        },
        "approvalRequired": false,
        "rollbackOnReject": true
      }
